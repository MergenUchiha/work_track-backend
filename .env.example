# =============================================================================
# WorkTrack Backend — environment variables
#
# Copy this file to `.env` and fill in the values:
#   cp .env.example .env
#
# Every variable is validated at startup (src/config/env.validation.ts).
# A missing or malformed value stops the app with a readable error instead
# of failing somewhere deep inside Passport or Prisma.
# =============================================================================

# ===========================
# APPLICATION
# ===========================

# development | production | test
NODE_ENV=development
PORT=3000

# Swagger UI at /api/docs.
# Unset: enabled in development, disabled in production.
# Set explicitly to override.
SWAGGER_ENABLED=true

# ===========================
# DATABASE
# ===========================

# Used by docker-compose to provision PostgreSQL.
POSTGRES_USER=worktrack
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=worktrack
POSTGRES_PORT=5432

# Connection string used by Prisma.
#   docker-compose : host is the service name → @postgres:5432
#   local database : @localhost:5432
DATABASE_URL=postgresql://worktrack:change-me-in-production@localhost:5432/worktrack

# ===========================
# JWT AUTHENTICATION
# ===========================

# Both secrets must be at least 32 characters — startup validation enforces it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Short-lived, sent with every API request
JWT_ACCESS_SECRET=change-me-generate-a-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m

# Long-lived, used only to obtain a new access token
JWT_REFRESH_SECRET=change-me-generate-a-different-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ===========================
# SECURITY
# ===========================

# bcrypt cost factor (10–15; higher is slower and stronger)
BCRYPT_ROUNDS=10

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Reverse proxies in front of the app: "1" behind a single nginx, empty when
# exposed directly. Without this every request appears to come from the proxy,
# and rate limiting treats all users as one client.
TRUST_PROXY=

# ===========================
# LOGGING
# ===========================

# error | warn | info | debug | verbose
LOG_LEVEL=info

# ===========================
# TELEGRAM BOT (optional)
# ===========================

# The API runs fine with the bot switched off — leave this false if you
# do not need it.
TELEGRAM_BOT_ENABLED=false

# Required when TELEGRAM_BOT_ENABLED=true. Get one from @BotFather.
# Format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=

# false = long polling (development) | true = webhook (production, needs HTTPS)
TELEGRAM_USE_WEBHOOK=false

# Required when TELEGRAM_USE_WEBHOOK=true
# TELEGRAM_WEBHOOK_DOMAIN=https://your-domain.com
# TELEGRAM_WEBHOOK_PATH=/telegram-webhook

# ===========================
# PRODUCTION CHECKLIST
# ===========================

# [ ] NODE_ENV=production
# [ ] New JWT_ACCESS_SECRET and JWT_REFRESH_SECRET (different from each other)
# [ ] Strong POSTGRES_PASSWORD, mirrored in DATABASE_URL
# [ ] CORS_ORIGINS limited to your real domains
# [ ] SWAGGER_ENABLED=false, unless the docs are meant to be public
# [ ] HTTPS webhook configured, if the bot is enabled
