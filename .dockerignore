# =============================================================
# WorkTrack Backend — .dockerignore
# Keeps the Docker build context small and the build fast

# =============================================================

# Dependencies are installed inside the image
node_modules/

# Build artefacts
dist/
build/

# Tests and coverage
coverage/
**/*.spec.ts
**/*.e2e-spec.ts
test/

# Logs
logs/
*.log
npm-debug.log*

# Environment files must never be baked into an image
.env
.env.local
.env.*.local

# Git data
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker files are not needed inside the image
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml

# Documentation
README.md
docs/

# Husky / lint-staged
.husky/

# Source maps already ship in dist/
*.map

# Temporary files
*.tmp
*.temp